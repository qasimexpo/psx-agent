# ---------------------------------------------------------------------------
# SmartSarmaya environment
#
# The pipeline (Python, GitHub Actions) writes to Neon.
# The site (Next.js, Vercel) reads from Neon and calls the AI providers.
# Everything below has a free tier.
# ---------------------------------------------------------------------------

# Neon Postgres connection string. Required by both the pipeline and the site.
# Neon dashboard -> your project -> Connection string -> pooled connection.
DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Groq API key. Free at https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini key, used only if Groq fails. Free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides.
# The pipeline uses the quality model because nobody is waiting for a cron job.
# The site uses the fast one because a person is.
GROQ_MODEL_QUALITY=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Frontend only. These belong in Vercel's environment variables.
# Anything prefixed NEXT_PUBLIC_ is visible in the browser, so never put a
# secret behind that prefix.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.smartsarmaya.com
NEXT_PUBLIC_GA_ID=G-835C87WVVW
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7107292781644653
# Ad unit slot IDs. All three are optional: the live units are compiled in as
# defaults, because NEXT_PUBLIC_ values are baked in at build time and a
# variable that is missing, or scoped to Preview instead of Production, gives
# you a build with no ad units and no error. Set these only to override.
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
# In-article unit used on /stock, /brief and /picks pages. Falls back to the
# bottom slot when empty, so those pages always carry one unit.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# Social profiles. Each one that is set appears in the footer and in the
# Organization sameAs list, which is how Google links the brand to them.
# Leave empty until the profile actually exists.
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_TELEGRAM=

# ---------------------------------------------------------------------------
# Telegram broadcast, used by the pipeline. Both must be set or every
# broadcast becomes a logged no-op.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Social broadcast, used by the pipeline. Each network is independent: with
# its variables missing it is skipped with a log line and the others still go
# out. These belong in GitHub repository secrets, not in Vercel.
# ---------------------------------------------------------------------------

# X. Needs a project with WRITE access and OAuth 1.0a user-context tokens,
# from https://developer.x.com. The free tier allows 500 posts a month; this
# schedule uses roughly 90.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Facebook Page. A Meta app plus a long-lived Page access token.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# Instagram. A Business account linked to that Page; it reuses the Page token
# above. Instagram can only publish an image it fetches from a public URL,
# which is what the site's /og route serves.
INSTAGRAM_USER_ID=
