# ---------------------------------------------------------------------------
# SmartSarmaya environment
#
# The pipeline (Python, GitHub Actions) writes to Neon.
# The site (Next.js, Vercel) reads from Neon and calls the AI providers.
# Everything below has a free tier.
# ---------------------------------------------------------------------------

# Neon Postgres connection string. Required by both the pipeline and the site.
# Neon dashboard -> your project -> Connection string -> pooled connection.
DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Groq API key. Free at https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini key, used only if Groq fails. Free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides.
# The pipeline uses the quality model because nobody is waiting for a cron job.
# The site uses the fast one because a person is.
GROQ_MODEL_QUALITY=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Frontend only. These belong in Vercel's environment variables.
# Anything prefixed NEXT_PUBLIC_ is visible in the browser, so never put a
# secret behind that prefix.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.smartsarmaya.com
NEXT_PUBLIC_GA_ID=G-835C87WVVW
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7107292781644653
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
